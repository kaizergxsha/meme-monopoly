{
  "name": "meme-monopoly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Онлайн-игра «Мемная Монополия» (Zero Donate, Authoritative Server, M1 Modes)",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "tunnel": "ssh -T -o StrictHostKeyChecking=no -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o IPQoS=lowdelay -o Compression=yes -R 80:127.0.0.1:3001 serveo.net",
    "test:qa": "tsx tests/qa_verify.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
